{
  "name": "chat-to-computer-mcp",
  "version": "0.4.0",
  "description": "Free, open-source MCP gateway connecting ChatGPT and other cloud AI chats to local Mac/Windows workspaces, with concurrent commands and native auto-update controls.",
  "license": "Apache-2.0",
  "author": "ChatToComputerMCP contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jingzhao-l/ChatToComputerMCP.git"
  },
  "homepage": "https://github.com/jingzhao-l/ChatToComputerMCP",
  "bugs": {
    "url": "https://github.com/jingzhao-l/ChatToComputerMCP/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin",
    "win32"
  ],
  "bin": {
    "chat-to-computer-mcp": "./bin/chat-to-computer-mcp.mjs"
  },
  "files": [
    "bin/",
    "macos/",
    "vendor/",
    "assets/branding/chat-to-computer-mcp/",
    "assets/branding/render_chat_to_computer_mcp_icon.swift",
    "build_macos_app.sh",
    "build_macos_icon.sh",
    "build_windows_app.ps1",
    "LICENSE",
    "README.md",
    "npm/README.md",
    "windows/FileMCP.Windows.sln",
    "windows/src/FileMCP.Core/*.cs",
    "windows/src/FileMCP.Core/*.csproj",
    "windows/src/FileMCP.App/*.cs",
    "windows/src/FileMCP.App/*.xaml",
    "windows/src/FileMCP.App/*.csproj",
    "windows/src/FileMCP.App/*.manifest",
    "windows/assets/*.ico",
    "docs/INSTALL_NPM.md",
    "docs/MULTI_WORKSPACE_SECURITY.md",
    "docs/GUI_CAPABILITIES.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs/ARCHITECTURE.md",
    "docs/TROUBLESHOOTING.md",
    "docs/PUBLISHING.md",
    "docs/ROADMAP.md",
    "docs/RELEASE_MIGRATION.md",
    "docs/UPSTREAM_ATTRIBUTION.md",
    "docs/PROJECT_SCOPE.md",
    "docs/CONNECT_CHATGPT.md",
    "docs/CONNECT_CHATGPT.zh-CN.md",
    "docs/VERIFIED_CLIENT_ACCESS.md",
    "docs/UPDATES.md"
  ],
  "scripts": {
    "test": "node --test npm/installer.test.mjs",
    "pack:check": "npm pack --dry-run --json"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "chatgpt",
    "claude",
    "local",
    "workspaces",
    "macos",
    "windows",
    "concurrent"
  ]
}
