<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ChatToComputerMCP</AssemblyName>
    <RootNamespace>FileMCP.App</RootNamespace>
    <Version>0.4.2</Version>
    <ApplicationIcon>..\..\assets\chat-to-computer-mcp.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FileMCP.Core\FileMCP.Core.csproj" />
    <Resource Include="..\..\assets\chat-to-computer-mcp.ico" Link="Assets\chat-to-computer-mcp.ico" />
  </ItemGroup>
</Project>
