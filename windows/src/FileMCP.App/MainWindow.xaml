<Window x:Class="FileMCP.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatToComputerMCP" Width="720" Height="650" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Icon="Assets/chat-to-computer-mcp.ico">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="12,4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" Grid.Row="0" Margin="0,0,0,12">
            <TabItem Header="Connection" x:Name="ConnectionTab">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Tunnel ID"/>
                    <TextBox x:Name="TunnelIdBox" Grid.Row="0" Grid.Column="1" ToolTip="OpenAI Secure MCP Tunnel ID (tunnel_ + 32 lowercase letters or digits)."/>

                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Runtime API key"/>
                    <PasswordBox x:Name="ApiKeyBox" Grid.Row="2" Grid.Column="1" ToolTip="Stored securely in Windows Credential Manager after saving."/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock x:Name="ApiKeyStatusText" VerticalAlignment="Center" Foreground="Gray"/>
                        <Button x:Name="DeleteApiKeyButton" Margin="12,0,0,0" Content="Delete API key" Click="DeleteApiKey_Click"/>
                    </StackPanel>

                    <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Foreground="Gray" TextWrapping="Wrap"
                               Text="ChatToComputerMCP connects this Windows PC to ChatGPT through OpenAI Secure MCP Tunnel. The local MCP server listens only on loopback."/>

                    <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SaveConnectionButton" Content="Save connection" Margin="0,0,8,0" Click="SaveConnection_Click"/>
                        <Button x:Name="ConnectButton" Content="Connect" Width="120" Click="Connect_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Settings" x:Name="SettingsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Shared directory"/>
                            <TextBox x:Name="DirectoryBox" Grid.Column="1" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="Browse…" Click="BrowseDirectory_Click"/>
                        </Grid>

                        <TextBlock Text="Additional approved workspaces"
                                   FontWeight="SemiBold" Margin="0,16,0,7"/>
                        <ListBox x:Name="WorkspaceListBox" Height="106" DisplayMemberPath="Name"
                                 SelectionChanged="WorkspaceSelectionChanged"/>
                        <TextBox x:Name="WorkspaceNameBox" Margin="0,7,0,6"
                                 ToolTip="Friendly name for the selected workspace (does not change its folder or ID)"/>
                        <WrapPanel>
                            <Button x:Name="AddWorkspaceButton" Content="Add folders…" Click="AddWorkspaces_Click" Margin="0,0,7,5"/>
                            <Button x:Name="RenameWorkspaceButton" Content="Rename" Click="RenameWorkspace_Click" Margin="0,0,7,5"/>
                            <Button x:Name="RemoveWorkspaceButton" Content="Remove approval" Click="RemoveWorkspace_Click" Margin="0,0,7,5"/>
                            <Button x:Name="RevealWorkspaceButton" Content="Reveal" Click="RevealWorkspace_Click" Margin="0,0,0,5"/>
                        </WrapPanel>
                        <TextBlock Text="Only folders approved here are accessible. Removing approval does not delete files. Save and reconnect to apply changes."
                                   Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,9"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Total concurrent commands" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox x:Name="CommandCapacityBox" Width="90" SelectedIndex="2"
                                      ToolTip="Shared total for all approved workspaces.">
                                <ComboBoxItem Content="4"/><ComboBoxItem Content="6"/><ComboBoxItem Content="8"/>
                                <ComboBoxItem Content="10"/><ComboBoxItem Content="12"/><ComboBoxItem Content="16"/>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="EnableCommandsCheckBox" Margin="120,14,0,0" Content="Allow shell commands"
                                  ToolTip="Allow ChatToComputerMCP to run PowerShell/CLI commands with the current Windows user's permissions."/>
                        <TextBlock Margin="120,5,0,0" Foreground="Gray" TextWrapping="Wrap"
                                   Text="Allows ChatGPT to run PowerShell/CLI commands with the current Windows user's permissions. Enable only for workspaces you trust."/>

                        <Expander x:Name="AdvancedExpander" Header="Advanced options" Margin="0,16,0,0">
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Profile"/>
                                <TextBox x:Name="ProfileBox" Grid.Row="0" Grid.Column="1" ToolTip="Letters, numbers, '.', '_' or '-', maximum 128 characters."/>
                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="MCP port"/>
                                <TextBox x:Name="PortBox" Grid.Row="2" Grid.Column="1"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Health listener"/>
                                <TextBox x:Name="HealthAddressBox" Grid.Row="4" Grid.Column="1" ToolTip="Loopback only. Port 0 requests an ephemeral tunnel-client health/admin port."/>
                                <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="Git name"/>
                                <TextBox x:Name="GitNameBox" Grid.Row="6" Grid.Column="1"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="Git email"/>
                                <TextBox x:Name="GitEmailBox" Grid.Row="8" Grid.Column="1"/>
                            </Grid>
                        </Expander>

                        <Button x:Name="SaveSettingsButton" Content="Save settings" HorizontalAlignment="Right" Margin="0,16,0,0" Click="SaveSettings_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Tasks">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TasksSummaryText" Grid.Row="0" Margin="0,0,0,8"
                               Text="Connect to review tasks across approved workspaces."
                               TextWrapping="Wrap" Foreground="Gray"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,9">
                        <Button Content="Refresh" Click="RefreshTasks_Click" Margin="0,0,8,0"/>
                        <Button x:Name="CancelTaskButton" Content="Cancel selected" Click="CancelTask_Click"
                                IsEnabled="False" />
                    </StackPanel>
                    <ListBox x:Name="TaskListBox" Grid.Row="2" DisplayMemberPath="Display"
                             SelectionChanged="TaskSelectionChanged"/>
                    <TextBlock x:Name="TaskDetailText" Grid.Row="3" Margin="0,8,0,0"
                               TextWrapping="Wrap" Foreground="Gray"
                               Text="Select a session to review its scope and status."/>
                </Grid>
            </TabItem>

            <TabItem Header="Logs">
                <Grid Margin="10">
                    <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" Background="#191919" Foreground="White"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="Gray"
                       Text="Closing the window keeps ChatToComputerMCP running in the system tray."/>
            <Button Grid.Column="1" Content="Quit ChatToComputer" Click="Quit_Click"/>
        </Grid>
    </Grid>
</Window>
