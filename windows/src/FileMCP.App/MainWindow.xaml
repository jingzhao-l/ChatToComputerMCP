<Window x:Class="FileMCP.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatToComputerMCP" Width="1000" Height="720" MinWidth="620" MinHeight="510"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Icon="Assets/chat-to-computer-mcp.ico"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="12,4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button x:Name="ThemeButton" DockPanel.Dock="Right" Content="Dark" Click="ToggleTheme_Click" AutomationProperties.Name="Switch appearance"/>
            <TextBlock Text="ChatToComputerMCP" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="0,0,0,12" TabStripPlacement="Left"
                    BorderThickness="0" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Width" Value="155"/>
                    <Setter Property="MinHeight" Value="40"/>
                    <Setter Property="Margin" Value="0,1,10,1"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="NavBackground" Background="Transparent" CornerRadius="6"
                                        Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="NavBackground" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="NavBackground" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="NavBackground" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="Top">
                            <Setter Property="Width" Value="Auto"/>
                            <Setter Property="MinHeight" Value="30"/>
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="Margin" Value="0,1,2,1"/>
                            <Setter Property="FontSize" Value="12"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TabControl.ItemContainerStyle>
            <TabItem Header="Overview" x:Name="OverviewTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Your local AI workspace gateway"
                                   FontSize="22" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,2,0,7"/>
                        <TextBlock Text="Connect ChatGPT, Claude and other compatible cloud AI chats to approved Windows folders, tools and concurrent commands."
                                   TextWrapping="Wrap" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,0,0,18"/>
                        <Border Padding="14" BorderBrush="#8890A5" BorderThickness="1"
                                CornerRadius="9" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Connection status" FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>
                                <TextBlock x:Name="OverviewConnectionStatus" Text="Disconnected"
                                           FontSize="17" Margin="0,0,0,4"/>
                                <TextBlock x:Name="OverviewProvider" Text="OpenAI Secure MCP Tunnel"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="14" BorderBrush="#8890A5" BorderThickness="1"
                                CornerRadius="9" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Approved workspaces" FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>
                                <TextBlock x:Name="OverviewWorkspaceSummary"
                                           Text="Choose a default workspace"
                                           TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <TextBlock x:Name="OverviewCommandCapacity" Text="8 concurrent commands"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="OverviewPermissions"
                                           Text="Shell off · Git push off · Codex history off"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Quick actions" FontWeight="SemiBold"
                                   Margin="0,7,0,8"/>
                        <WrapPanel Margin="0,0,0,11">
                            <Button Content="Connection" Margin="0,0,8,7"
                                    Click="OverviewConnection_Click"/>
                            <Button Content="Manage workspaces" Margin="0,0,8,7"
                                    Click="OverviewWorkspaces_Click"/>
                            <Button Content="Running tasks" Margin="0,0,8,7"
                                    Click="OverviewTasks_Click"/>
                            <Button Content="Check updates" Margin="0,0,0,7"
                                    Click="OverviewUpdates_Click"/>
                        </WrapPanel>
                        <TextBlock Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap"
                                   Text="Local workspace access requires your approval. Shell commands use your Windows account permissions and are not an operating-system sandbox. OpenAI Secure MCP Tunnel credentials are connection-level; verified per-client grants require Cloudflare OAuth."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Workspaces" x:Name="SettingsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Shared directory"/>
                            <TextBox x:Name="DirectoryBox" Grid.Column="1" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" x:Name="BrowseDirectoryButton" Content="Browse…" Click="BrowseDirectory_Click"/>
                        </Grid>

                        <TextBlock Text="Additional approved workspaces"
                                   FontWeight="SemiBold" Margin="0,16,0,7"/>
                        <ListBox x:Name="WorkspaceListBox" Height="148" SelectionChanged="WorkspaceSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="3,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Path}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Path}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBox x:Name="WorkspaceNameBox" Margin="0,7,0,6"
                                 ToolTip="Friendly name for the selected workspace (does not change its folder or ID)"/>
                        <WrapPanel>
                            <Button x:Name="AddWorkspaceButton" Content="Add folders…" Click="AddWorkspaces_Click" Margin="0,0,7,5"/>
                            <Button x:Name="RenameWorkspaceButton" Content="Rename" Click="RenameWorkspace_Click" Margin="0,0,7,5"/>
                            <Button x:Name="RemoveWorkspaceButton" Content="Remove approval" Click="RemoveWorkspace_Click" Margin="0,0,7,5"/>
                            <Button x:Name="WorkspacePermissionButton" Content="Permissions…" Click="WorkspacePermissions_Click" Margin="0,0,7,5"/>
                            <Button x:Name="DefaultPermissionButton" Content="Default permissions…" Click="DefaultPermissions_Click" Margin="0,0,7,5"/>
                            <Button x:Name="CopyWorkspaceScopeButton" Content="Copy AI scope" Click="CopyWorkspaceScope_Click" Margin="0,0,7,5" IsEnabled="False"/>
                            <Button x:Name="RevealWorkspaceButton" Content="Reveal" Click="RevealWorkspace_Click" Margin="0,0,0,5"/>
                        </WrapPanel>
                        <TextBlock x:Name="WorkspacePermissionText" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap"/>
                        <TextBlock Text="Additional workspaces can be changed online while affected scopes are idle. OAuth changes require fresh authorization. Default/global changes require reconnect. Removing approval never deletes files."
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap" Margin="0,4,0,9"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Total concurrent commands" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox x:Name="CommandCapacityBox" Width="90" SelectedIndex="2"
                                      ToolTip="Shared total for all approved workspaces.">
                                <ComboBoxItem Content="4"/><ComboBoxItem Content="6"/><ComboBoxItem Content="8"/>
                                <ComboBoxItem Content="10"/><ComboBoxItem Content="12"/><ComboBoxItem Content="16"/>
                            </ComboBox>
                        </StackPanel>
                        <Button x:Name="SaveSettingsButton" Content="Save workspace" HorizontalAlignment="Right" Margin="0,16,0,0" Click="SaveSettings_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Connection" x:Name="ConnectionTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Connection provider" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ProviderBox" SelectionChanged="ProviderChanged"
                                  Margin="0,0,0,12" MinHeight="32">
                            <ComboBoxItem Tag="openai" Content="OpenAI Secure MCP Tunnel"/>
                            <ComboBoxItem Tag="cloudflare" Content="Cloudflare Tunnel · verified OAuth clients"/>
                        </ComboBox>
                        <TextBlock Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Select the tunnel that connects cloud AI chats to your approved local computer workspaces. Credentials are saved only in this Windows user's Credential Manager."/>

                        <StackPanel x:Name="OpenAIConnectionGroup">
                            <TextBlock Text="Secure MCP Tunnel ID" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="TunnelIdBox" ToolTip="tunnel_ followed by 32 lowercase letters/digits."
                                     Margin="0,0,0,12"/>
                            <TextBlock Text="OpenAI Platform runtime API key" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="ApiKeyBox" Margin="0,0,0,5"
                                         ToolTip="A Platform runtime key, not your ChatGPT subscription."/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock x:Name="ApiKeyStatusText" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="DeleteApiKeyButton" Content="Delete API key"
                                        Margin="12,0,0,0" Click="DeleteApiKey_Click"/>
                            </StackPanel>
                            <TextBlock Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Private OpenAI Secure MCP Tunnel uses a shared local connection identity. Individual ChatGPT chats cannot be cryptographically distinguished by this mode."/>
                        </StackPanel>

                        <StackPanel x:Name="CloudflareConnectionGroup" Visibility="Collapsed">
                            <TextBlock Text="Cloudflare public hostname" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="CloudflareHostnameBox" Margin="0,0,0,10"
                                     ToolTip="DNS hostname for your Cloudflare Tunnel, e.g. mcp.example.com."/>
                            <TextBlock Text="Tunnel management" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CloudflareModeBox" MinHeight="30"
                                      SelectionChanged="CloudflareModeChanged"
                                      Margin="0,0,0,10">
                                <ComboBoxItem Tag="token" Content="Cloudflare remotely-managed dashboard token"/>
                                <ComboBoxItem Tag="named" Content="Named tunnel in local Cloudflare account"/>
                            </ComboBox>
                            <StackPanel x:Name="CloudflareTokenGroup">
                                <TextBlock Text="Cloudflare remotely-managed tunnel token"
                                           FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="CloudflareTokenBox" Margin="0,0,0,6"
                                         ToolTip="Stored in Windows Credential Manager; never added to command line arguments."/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                <TextBlock x:Name="CloudflareTokenStatusText" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="DeleteCloudflareTokenButton" Content="Delete token"
                                        Click="DeleteCloudflareToken_Click" Margin="12,0,0,0"/>
                            </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="CloudflareNamedGroup" Visibility="Collapsed">
                                <TextBlock Text="Cloudflare named tunnel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CloudflareTunnelNameBox" MinHeight="30"
                                          IsEditable="True" Margin="0,0,0,8"
                                          ToolTip="Select an existing tunnel or type a new name."/>
                                <WrapPanel Margin="0,0,0,8">
                                    <Button x:Name="CloudflareLoginButton" Content="Log in"
                                            Click="CloudflareLogin_Click" Margin="0,0,7,5"/>
                                    <Button x:Name="CloudflareRefreshButton" Content="Refresh tunnels"
                                            Click="CloudflareRefresh_Click" Margin="0,0,7,5"/>
                                    <Button x:Name="CloudflareCreateButton" Content="Create"
                                            Click="CloudflareCreate_Click" Margin="0,0,7,5"/>
                                    <Button x:Name="CloudflareRouteDnsButton" Content="Set DNS route"
                                            Click="CloudflareRouteDns_Click" Margin="0,0,7,5"/>
                                    <Button x:Name="CloudflareDeleteButton" Content="Delete"
                                            Click="CloudflareDelete_Click" Margin="0,0,7,5"/>
                                </WrapPanel>
                                <TextBlock x:Name="CloudflareManagementStatus" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                           TextWrapping="Wrap" Margin="0,0,0,9"
                                           Text="Install and log in to cloudflared.exe first. Named tunnel credentials stay in your Cloudflare account."/>
                            </StackPanel>
                            <TextBlock Text="Local OAuth pairing code" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock x:Name="CloudflarePairingStatusText" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                           VerticalAlignment="Center"
                                           Text="A private pairing code is generated when connecting."/>
                                <Button x:Name="CopyCloudflarePairingButton" Content="Copy login code"
                                        Margin="10,0,7,0" Click="CopyCloudflarePairing_Click"/>
                                <Button x:Name="ResetCloudflarePairingButton" Content="Regenerate"
                                        Click="ResetCloudflarePairing_Click"/>
                            </StackPanel>
                            <TextBlock Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Install cloudflared.exe separately and configure the entire hostname, including /mcp, /oauth/* and /.well-known/*, to reach this local MCP server. Default OAuth mode is safer than embedding secrets in URLs."/>
                            <TextBlock Text="Authorized OAuth clients" FontWeight="SemiBold" Margin="0,8,0,6"/>
                            <TextBlock Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Client names are self-reported. Verified access tokens determine each client identity and approved workspace scope."/>
                            <ListBox x:Name="OAuthClientListBox" Height="95"
                                     DisplayMemberPath="Display"
                                     SelectionChanged="OAuthClientSelectionChanged"
                                     Margin="0,0,0,6"/>
                            <TextBlock x:Name="OAuthClientScopeText" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                       TextWrapping="Wrap" Margin="0,0,0,7"
                                       Text="Connect with Cloudflare OAuth to list approved clients."/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="RefreshOAuthClientsButton" Content="Refresh clients"
                                        Click="RefreshOAuthClients_Click" Margin="0,0,8,0"/>
                                <Button x:Name="RevokeOAuthClientButton" Content="Revoke selected"
                                        Click="RevokeOAuthClient_Click" IsEnabled="False"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap" Margin="0,8,0,14"
                                   Text="The local server listens on loopback. Approve workspaces in Settings first, then save and connect. Changes to provider and access scopes require reconnecting."/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SaveConnectionButton" Content="Save connection"
                                    Margin="0,0,8,0" Click="SaveConnection_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Command center" x:Name="TasksTab">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="170"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="TasksSummaryText"
                                   Text="Connect to review tasks across approved workspaces."
                                   TextWrapping="Wrap" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                        <TextBlock x:Name="ReceiptStatusText" Margin="0,5,0,0"
                                   Text="Connect to view prior interrupted command receipts."
                                   TextWrapping="Wrap" Foreground="DarkOrange"/>
                    </StackPanel>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,9">
                        <Button Content="Refresh" Click="RefreshTasks_Click" Margin="0,0,8,0"/>
                        <Button Content="History…" Click="OpenCommandHistory_Click" Margin="0,0,8,0"/>
                        <Button x:Name="CancelTaskButton" Content="Cancel selected" Click="CancelTask_Click"
                                IsEnabled="False" Margin="0,0,8,0"/>
                        <Button x:Name="RevealTaskButton" Content="Open folder" Click="RevealTask_Click"
                                IsEnabled="False" Margin="0,0,8,0"/>
                        <Button x:Name="CopyTaskOutputButton" Content="Copy output" Click="CopyTaskOutput_Click"
                                IsEnabled="False" ToolTip="Command output may contain secrets. Review before sharing."/>
                    </WrapPanel>
                    <ListBox x:Name="TaskListBox" Grid.Row="2" DisplayMemberPath="Display"
                             SelectionChanged="TaskSelectionChanged"/>
                    <TextBlock x:Name="TaskDetailText" Grid.Row="3" Margin="0,8,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               Text="Select a session to review its scope and status."/>
                    <TextBox x:Name="TaskOutputBox" VerticalContentAlignment="Top" Grid.Row="4" Margin="0,9,0,0"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11"
                             ToolTip="Captured, bounded stdout/stderr of the selected command session; refreshes automatically while visible."/>
                </Grid>
            </TabItem>

            <TabItem Header="Activity">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8">
                        <CheckBox x:Name="FollowLogsBox" Content="Follow" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0" Click="FollowLogs_Click"/>
                        <Button Content="Activity audit…" Click="OpenActivityAudit_Click" Margin="0,0,8,0"/>
                        <Button x:Name="CopyLogsButton" Content="Copy" Click="CopyLogs_Click" IsEnabled="False" Margin="0,0,8,0"/>
                        <Button Content="Clear" Click="ClearLogs_Click"/>
                    </WrapPanel>
                    <TextBox Grid.Row="1" x:Name="LogBox" VerticalContentAlignment="Top" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" Background="#191919" Foreground="White"/>
                </Grid>
            </TabItem>
            <TabItem Header="Security" x:Name="SecurityTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Permissions &amp; security" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Global permissions are upper bounds. Individual workspace restrictions are managed in Workspaces. OAuth verifies a client grant, not a chat conversation." TextWrapping="Wrap" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="EnableCommandsCheckBox" Margin="0,14,0,0" Content="Allow shell commands"
                                  ToolTip="Allow ChatToComputerMCP to run PowerShell/CLI commands with the current Windows user's permissions."/>
                        <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap"
                                   Text="Allows ChatGPT to run PowerShell/CLI commands with the current Windows user's permissions. Enable only for workspaces you trust."/>
                        <CheckBox x:Name="PersistLongTasksBox" Margin="0,10,0,0" Content="Keep running commands through app restarts (stores bounded output)" ToolTip="Quitting preserves launched jobs; Disconnect cancels. Queued jobs are never replayed."/>
                        <CheckBox x:Name="CaptureCommandHistoryBox" Margin="0,10,0,0"
                                  Content="Keep command text and output in local history"
                                  ToolTip="May contain secrets. Off by default; only local metadata is recorded unless you opt in."/>
                        <CheckBox x:Name="EnableGitPushBox" Content="Allow Git push to remote servers"
                                  Margin="0,12,0,0"
                                  ToolTip="Sends repository contents to configured remote servers and may use existing credentials. Disabled by default."/>
                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap"
                                   Text="Git push can disclose source to remotes and requires separate approval."/>

                        <Button x:Name="SaveSecurityButton" Content="Save permissions" HorizontalAlignment="Right" Margin="0,16,0,0" Click="SaveSettings_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Settings" x:Name="PreferencesTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Application settings" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Expander Header="Optional integrations" Margin="0,16,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <CheckBox x:Name="EnableCodexHistoryBox" Content="Allow importing conversations into Codex history"
                                          ToolTip="Writes conversation content to the user's Codex history outside approved workspaces. Disabled by default."/>
                                <TextBlock Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap" Margin="0,5,0,0"
                                           Text="Enable only if you use Codex. Import writes outside approved folders, and workspace-specific permission still applies."/>
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="AdvancedExpander" Header="Advanced options" Margin="0,16,0,0">
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Profile"/>
                                <TextBox x:Name="ProfileBox" Grid.Row="0" Grid.Column="1" ToolTip="Letters, numbers, '.', '_' or '-', maximum 128 characters."/>
                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="MCP port"/>
                                <TextBox x:Name="PortBox" Grid.Row="2" Grid.Column="1"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Health listener"/>
                                <TextBox x:Name="HealthAddressBox" Grid.Row="4" Grid.Column="1" ToolTip="Loopback only. Port 0 requests an ephemeral tunnel-client health/admin port."/>
                                <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="Git name"/>
                                <TextBox x:Name="GitNameBox" Grid.Row="6" Grid.Column="1"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="Git email"/>
                                <TextBox x:Name="GitEmailBox" Grid.Row="8" Grid.Column="1"/>
                            </Grid>
                        </Expander>

                        <TextBlock Text="Background service (optional)" FontWeight="SemiBold"
                                   Margin="0,18,0,7"/>
                        <TextBlock Text="Login startup uses this user's Windows startup registration and a small in-app supervisor. Nothing is installed or started unless explicitly enabled. Crash recovery restarts an abnormal exit; Always-on also relaunches normal Quit."
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <CheckBox x:Name="LoginStartupBox"
                                  Content="Start ChatToComputerMCP at user sign-in (minimized to tray)"
                                  Click="LoginOptions_Click" Margin="0,0,0,5"/>
                        <CheckBox x:Name="LoginAutoConnectBox"
                                  Content="Automatically reconnect the approved MCP tunnel"
                                  Click="LoginOptions_Click" IsEnabled="False" Margin="0,0,0,5"/>
                        <CheckBox x:Name="LoginAlwaysOnBox"
                                  Content="Always keep the app running (even after Quit)"
                                  Click="LoginOptions_Click" IsEnabled="False" Margin="0,0,0,8"/>
                        <Button x:Name="ApplyLoginSettingsButton"
                                Content="Apply Windows login settings"
                                HorizontalAlignment="Left"
                                Click="ApplyLoginSettings_Click"/>
                        <TextBlock x:Name="LoginStatusText" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   TextWrapping="Wrap" Margin="0,7,0,0"
                                   Text="Login startup is disabled."/>
                        <TextBlock Text="Application updates" FontWeight="SemiBold"
                                   Margin="0,18,0,7"/>
                        <TextBlock Text="Updates use official npm releases and compile a separate app version. The running connection and tasks are never restarted automatically."
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock x:Name="UpdateStatusText" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   TextWrapping="Wrap" Margin="0,0,0,7"
                                   Text="Check npm for a newer release."/>
                        <CheckBox x:Name="AutoCheckUpdatesBox"
                                  Content="Check for updates automatically while the app is open"
                                  Click="UpdateOptions_Click" Margin="0,0,0,5"/>
                        <CheckBox x:Name="AutoInstallUpdatesBox"
                                  Content="Automatically install new releases (never auto-restart)"
                                  Click="UpdateOptions_Click" Margin="0,0,0,8"
                                  IsEnabled="False"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="CheckUpdatesButton" Content="Check for updates"
                                    Click="CheckUpdates_Click" Margin="0,0,8,0"/>
                            <Button x:Name="InstallUpdateButton" Content="Install update"
                                    Click="InstallUpdate_Click" IsEnabled="False"/>
                            <Button x:Name="ActivateUpdateButton" Content="Activate update…" Margin="8,0,0,0"
                                    Click="ActivateUpdate_Click" IsEnabled="False"/>
                        </StackPanel>

                        <Button x:Name="SavePreferencesButton" Content="Save settings" HorizontalAlignment="Right" Margin="0,16,0,0" Click="SaveSettings_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="FooterStatus" Text="Disconnected" FontWeight="SemiBold"/>
                <TextBlock Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" FontSize="11" Text="Closing the window keeps the gateway in the tray." TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Quit" Click="Quit_Click" Margin="0,0,8,0"/>
                <Button x:Name="ConnectButton" Content="Connect" Width="126" Click="Connect_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
